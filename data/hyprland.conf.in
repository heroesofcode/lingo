# Lingo: generated by tools/install.sh (feel free to edit)

# Floating window, pinned to every workspace, in the top right corner.
windowrule {
    name = lingo-overlay
    match:class = ^(dev\.pedro\.Lingo)$

    float = yes
    pin = yes
    size = 470 820
    move = monitor_w-490 50
}

bind = SUPER ALT, L, exec, @LINGO@ --toggle
bind = SUPER ALT, R, exec, @LINGO@ --suggest
bind = SUPER ALT, P, exec, @LINGO@ --pause
bind = SUPER ALT, A, exec, @LINGO@ --ask
